    "html-pdf-node": "file:libs/html-pdf-node",
    "jimp": "1.6.0",
    "jsonwebtoken": "9.0.3",
    "lodash": "4.17.21",
    "md5": "2.3.0",
    "moment-timezone": "0.6.0",
    "mysql2": "3.16.1",
    "nodemailer": "^7.0.12",
    "p-limit": "^7.2.0",
    "parse5": "8.0.0",
    "path-to-regexp": "8.3.0",
    "pidusage": "^4.0.1",
    "rate-limiter-flexible": "^9.0.1",
    "request-ip": "3.3.0",
