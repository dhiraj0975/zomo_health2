{
  "name": "zomohealth-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "set NODE_ENV=DEV&&nest start --watch",
    "start:local": "set NODE_ENV=DEV&&nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "cucumber-js features/permission/role-permission.feature",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "docs": "apidoc -i src -o public/apidoc"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.971.0",
    "@aws-sdk/client-sts": "^3.971.0",
    "@aws-sdk/client-translate": "^3.971.0",
    "@aws-sdk/s3-request-presigner": "^3.971.0",
    "@cucumber/cucumber": "12.5.0",
    "@eslint/config-array": "0.23.0",
    "@nestjs/common": "11.1.12",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.12",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/microservices": "11.1.12",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "^11.1.12",
    "@nestjs/platform-socket.io": "^11.1.12",
    "@nestjs/schedule": "6.1.0",
    "@nestjs/serve-static": "^5.0.4",
    "@nestjs/swagger": "^11.2.5",
    "@nestjs/typeorm": "11.0.0",
    "@nestjs/websockets": "11.1.12",
    "@types/multer": "2.0.0",
    "archiver": "7.0.1",
    "argon2": "0.44.0",
    "axios": "1.13.2",
    "child_process": "1.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
