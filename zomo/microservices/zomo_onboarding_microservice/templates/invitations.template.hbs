<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="font-family:roboto;">
    <div class="main">
        <div class="outblk" style="margin:auto; display:block; max-width:740px; color: #000;">
            <div class="innerblk" style="margin:0 30px;">
                <p style="margin: 44px 0 0 14px;"><img src="{{IMAGE_BASE_URL}}/templateImages/zomologo.png" alt="zomologo" style="width: 206px; height: 39px;"></p>
            </div>
            <div style="font-size: 18px;">
                <p style="text-align: center;"><img src="{{IMAGE_BASE_URL}}/templateImages/UserRegistration.png" alt="User Registration" style="width: 500px; height: 372px;"></p>
                <p style="margin-left: 44px; margin-top: 40px; margin-right: 44px;">Hello {{first_name}},</p>
                <div style="margin-left: 44px; margin-top: 30px; margin-right: 44px;">
                    Welcome to <strong>ZomoHealth</strong>! We’re excited to have you on board.
                </div>
                <p style="margin-left: 45px; margin-top: 30px; margin-right: 44px;"><a target="_blank" href="{{IMAGE_BASE_URL}}" style="color: #209985; text-transform: none;">{{IMAGE_BASE_URL}}</a></p>
                <p style="margin: 60px 0 0 44px ;">Thank you,</p>
                <p style="margin: 8px 0 50px 44px ;">{{company_name}}</p>
            </div>

            <div style="background-color: #f1f7f8;width:740px;height:221px;">
                <div style="margin:40px 0 0 0;width:660px;height:99px;">
                    <p style="padding:40px 0 0 44px;color:#111827;"><b>Download our Zomo health app</b></p>
                    <table style="font-size: 16px;margin:14px 0 0 0;">
                        <tbody>
                            <tr>
                                <td style="padding: 0 0 0 40px;"><a href="#" target="_blank" style="text-decoration: none;"><img src="{{IMAGE_BASE_URL}}/templateImages/googleplay.png"></a></td>
                                <td style="padding: 0 0 0 8px;"><a href="#" target="_blank" style="text-decoration: none;"><img src="{{IMAGE_BASE_URL}}/templateImages/applestore.png"></a></td>
                                <td style="padding: 0 0 0 70px;text-align: center;"><img src="{{IMAGE_BASE_URL}}/templateImages/aicpasoc.png"></td>
                                <td style="padding: 0 0 0 18px;"><img src="{{IMAGE_BASE_URL}}/templateImages/Hippa.png"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div style="margin:75px 0 0 40px;width:474px;height:26px;">
                    <table style="font-size: 15px;">
                        <tbody>
                            <tr>
                                <td style="color:#111827;text-align:center;">1-877-506-5885</td>
                                <td style="width:40px;text-align:center;margin: 0 0 0 20px;"><img src="{{IMAGE_BASE_URL}}/templateImages/ellipse.png"></td>
                                <td style="width:30px;text-align:center;margin: 0 0 0 15px;"><a href="mailto:support@zomohealth.com" style="text-decoration: none;color:#111827;" target="_blank">support@zomohealth.com</a></td>
                                <td style="width:40px;text-align:center;margin: 0 0 0 20px;"><img src="{{IMAGE_BASE_URL}}/templateImages/ellipse.png"></td>
                                <td style="width:30px;text-align:center;margin:0 0 0 15px;"><a href="#" style="text-decoration: none;color:#111827;" target="_blank">
                                Unsubscribe</a></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</body>
</html>